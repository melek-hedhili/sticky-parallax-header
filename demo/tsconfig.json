{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "@mhedhili/react-native-sticky-parallax-header": ["../src/index.tsx"],
      "@mhedhili/react-native-sticky-parallax-header/flash-list": ["../src/flash-list.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "react-native/*": ["./node_modules/react-native/*"],
      "react-native-gesture-handler": ["./node_modules/react-native-gesture-handler"],
      "react-native-gesture-handler/*": ["./node_modules/react-native-gesture-handler/*"],
      "react-native-reanimated": ["./node_modules/react-native-reanimated"],
      "react-native-reanimated/*": ["./node_modules/react-native-reanimated/*"],
      "react-native-worklets": ["./node_modules/react-native-worklets"],
      "react-native-worklets/*": ["./node_modules/react-native-worklets/*"],
      "react-native-safe-area-context": ["./node_modules/react-native-safe-area-context"],
      "react-native-safe-area-context/*": ["./node_modules/react-native-safe-area-context/*"],
      "@shopify/flash-list": ["./node_modules/@shopify/flash-list"],
      "@shopify/flash-list/*": ["./node_modules/@shopify/flash-list/*"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "build",
    "dist",
    "../src/__tests__",
    "../src/__fixtures__"
  ]
}
