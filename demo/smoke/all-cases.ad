# Expo Go validation smoke: render, scroll ref, refresh state, pager/tab navigation.
# Metro must stay available; the caller supplies the explicit Expo Go project URL.
open "${PROJECT_URL}"
wait 'label="Validation cases"' 30000
scroll down --until 'id="case-primitive-scrollview"'
wait 'id="case-primitive-scrollview"' 15000
press 'id="case-primitive-scrollview"'
wait 'id="scroll-to-top"' 10000
scroll down 0.35
press 'id="scroll-to-top"'
wait 'label="Row 1"' 10000
press 'id="refresh"'
wait text "Refresh complete" 10000
press 'id="all-cases"'
wait stable 300 10000
scroll down --until 'id="case-primitive-flatlist"'
