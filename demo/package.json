{
  "name": "sticky-parallax-header-demo",
  "description": "Unified Expo Go and web demo for react-native-sticky-parallax-header",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "generate:routes": "node scripts/generate-routes.cjs",
    "typecheck": "yarn generate:routes && tsc --noEmit",
    "lint": "yarn --cwd .. lint:demo",
    "build:web": "expo export --platform web",
    "build:bundles": "expo export --platform all",
    "check:dependencies": "expo install --check",
    "doctor": "expo-doctor",
    "smoke:ios": "node scripts/smoke.cjs ios",
    "smoke:android": "node scripts/smoke.cjs android",
    "test:ci": "node ../node_modules/jest/bin/jest.js --config jest.config.cjs --ci --runInBand --watchman=false"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@shopify/flash-list": "2.0.2",
    "expo": "57.0.27",
    "expo-blur": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "expo-system-ui": "~57.0.4",
    "expo-router": "~57.0.25",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-preset-expo": "~57.0.14",
    "react-refresh": "0.19.0",
    "typescript": "6.0.3",
    "expo-doctor": "1.20.4",
    "@react-native/metro-config": "0.86.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
