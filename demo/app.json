{
  "expo": {
    "name": "Sticky Parallax Header Demo",
    "slug": "sticky-parallax-header-demo",
    "scheme": "sticky-parallax-demo",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": false
    }
  }
}
