{
  "name": "react-native-sticky-parallax-header-example",
  "description": "Example app for react-native-sticky-parallax-header",
  "version": "0.0.1",
  "private": true,
  "main": "index",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "build:bundles": "expo export --platform all",
    "check:dependencies": "expo install --check",
    "prebuild": "expo prebuild --clean --no-install",
    "build:android": "cd android && ./gradlew :app:assembleDebug --max-workers=2",
    "build:ios": "xcodebuild -jobs 2 -workspace ios/reactnativestickyparallaxheaderexample.xcworkspace -scheme reactnativestickyparallaxheaderexample -configuration Debug -sdk iphonesimulator -derivedDataPath build/ios CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/stack": "7.12.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "57.0.26",
    "expo-blur": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "expo-system-ui": "~57.0.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-preset-expo": "57.0.13",
    "react-refresh": "0.19.0",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@1.22.22"
}
