{
  "extends": "./tsconfig",
  "compilerOptions": {
    "rootDir": "src",
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/__fixtures__/**",
    "src/**/__mocks__/**",
    "node_modules",
    "lib",
    "demo",
    "docs"
  ]
}
