{
  "name": "react-native-sticky-parallax-header",
  "version": "1.1.1",
  "packageManager": "yarn@1.22.22",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "files": [
    "src/constants",
    "src/hooks",
    "src/predefinedComponents",
    "src/primitiveComponents",
    "src/index.tsx",
    "src/flash-list.ts",
    "lib"
  ],
  "repository": "https://github.com/netguru/sticky-parallax-header",
  "author": "IdaszakDaniel <idaszak1@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:ci": "jest --ci --runInBand --watchman=false",
    "typescript": "tsc --noEmit",
    "lint": "eslint src scripts jest babel.config.js commitlint.config.js jest.config.js eslint.config.cjs",
    "build": "bob build",
    "check:static": "yarn lint && yarn typescript && yarn build",
    "prepare": "bob build && husky",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install && cd ..",
    "bootstrap": "yarn example && yarn && yarn pods",
    "prepush": "yarn lint && yarn typescript",
    "example:android": "yarn example android",
    "example:ios": "yarn example ios",
    "example:web": "yarn example web",
    "example:studio": "studio example/android",
    "example:xcode": "xed example/ios",
    "test:types": "node scripts/verify-package-types.cjs",
    "example:typecheck": "yarn --cwd example typecheck",
    "test-app": "yarn --cwd test-app",
    "docs:typecheck": "yarn --cwd docs typecheck",
    "lint:example": "eslint example",
    "lint:docs": "eslint docs",
    "lint:test-app": "eslint test-app",
    "lint:all": "yarn lint && yarn lint:example && yarn lint:docs && yarn lint:test-app"
  },
  "peerDependencies": {
    "react": "~19.2.3",
    "react-native": "~0.86.3 || ~0.87.1",
    "react-native-reanimated": "~4.5.1 || ~4.7.1",
    "react-native-worklets": "~0.10.1 || ~0.13.0",
    "react-native-safe-area-context": "^5.7.0",
    "@shopify/flash-list": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@shopify/flash-list": "2.3.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "pod-install": "1.1.0",
    "prettier": "3.9.9",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "0.43.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-worklets": "0.13.0",
    "release-it": "21.1.0",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "24.19.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "release-it": {
    "hooks": {
      "after:release": "git checkout -b releases/v_${version} && git push -u origin releases/v_${version}"
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "push": false
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./src/index.tsx"
      },
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./flash-list": {
      "react-native": {
        "types": "./lib/typescript/module/flash-list.d.ts",
        "default": "./src/flash-list.ts"
      },
      "import": {
        "types": "./lib/typescript/module/flash-list.d.ts",
        "default": "./lib/module/flash-list.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/flash-list.d.ts",
        "default": "./lib/commonjs/flash-list.js"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "@shopify/flash-list": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7"
  }
}
