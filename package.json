{
  "name": "@mhedhili/react-native-sticky-parallax-header",
  "version": "2.0.0-beta.2",
  "packageManager": "yarn@1.22.22",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "files": [
    "src/constants",
    "src/hooks",
    "src/predefinedComponents",
    "src/primitiveComponents",
    "src/index.tsx",
    "src/flash-list.ts",
    "lib"
  ],
  "repository": "https://github.com/melek-hedhili/sticky-parallax-header",
  "homepage": "https://github.com/melek-hedhili/sticky-parallax-header",
  "author": "IdaszakDaniel <idaszak1@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:ci": "jest --ci --runInBand --watchman=false",
    "typescript": "tsc --noEmit",
    "lint": "eslint src scripts jest babel.config.js commitlint.config.js jest.config.js eslint.config.cjs",
    "build": "bob build",
    "check:static": "yarn lint && yarn typescript && yarn build",
    "prepare": "bob build && husky",
    "release": "release-it --no-increment",
    "prepush": "yarn lint && yarn typescript",
    "test:types": "node scripts/verify-package-types.cjs",
    "docs:typecheck": "yarn --cwd docs typecheck",
    "lint:docs": "eslint docs",
    "lint:all": "yarn lint && yarn lint:demo && yarn lint:docs",
    "demo": "yarn --cwd demo",
    "demo:android": "yarn demo android",
    "demo:ios": "yarn demo ios",
    "demo:web": "yarn demo web",
    "demo:typecheck": "yarn --cwd demo typecheck",
    "lint:demo": "eslint demo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.83.0 || ~0.86.3 || ~0.87.1 || ~0.88.0",
    "react-native-gesture-handler": "~2.30.0 || ~2.32.0 || ~3.3.0",
    "react-native-reanimated": "~4.2.1 || ~4.5.1 || ~4.7.1",
    "react-native-worklets": "~0.7.4 || ~0.10.1 || ~0.13.0",
    "react-native-safe-area-context": "^5.6.2",
    "@shopify/flash-list": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@shopify/flash-list": "2.3.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "prettier": "3.9.9",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-builder-bob": "0.43.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-worklets": "0.13.0",
    "release-it": "21.1.0",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "24.19.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "release-it": {
    "git": {
      "requireBranch": "master",
      "commit": false,
      "tagName": "v${version}",
      "push": true
    },
    "npm": {
      "publish": true,
      "tag": "next"
    },
    "github": {
      "release": true,
      "preRelease": true,
      "makeLatest": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./src/index.tsx"
      },
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./flash-list": {
      "react-native": {
        "types": "./lib/typescript/module/flash-list.d.ts",
        "default": "./src/flash-list.ts"
      },
      "import": {
        "types": "./lib/typescript/module/flash-list.d.ts",
        "default": "./lib/module/flash-list.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/flash-list.d.ts",
        "default": "./lib/commonjs/flash-list.js"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "@shopify/flash-list": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7"
  }
}
